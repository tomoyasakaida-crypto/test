# APS (Autodesk Platform Services) Credentials
# Get these from https://aps.autodesk.com/myapps

# IMPORTANT:
# 1. Copy this file to .env
# 2. Replace the values below with your actual credentials
# 3. Add http://localhost:8080/callback to your app's Callback URLs in APS Developer Portal

APS_CLIENT_ID=your_client_id_here
APS_CLIENT_SECRET=your_client_secret_here
